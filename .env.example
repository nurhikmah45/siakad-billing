# =====================================================================
# TEMPLATE KONFIGURASI (12-Factor App, Faktor III: Config in Environment)
# Salin ke .env lalu sesuaikan:
#   Linux/macOS/Git Bash : cp .env.example .env
#   Windows PowerShell   : Copy-Item .env.example .env
# JANGAN isi kredensial asli di berkas ini. Berkas .env tidak boleh di-commit.
# =====================================================================

# Lingkungan: development | staging | production | testing
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database (SQLite lokal untuk development)
DATABASE_URL=sqlite:///siakad_dev.db

# Payment gateway kampus (gunakan sandbox + token dummy untuk lokal)
PAYMENT_GATEWAY_URL=https://sandbox.bank.uinam.ac.id/api/v1
PAYMENT_API_KEY=dummy_sandbox_api_key

# WhatsApp notifier (opsional, ada default aman)
WA_GATEWAY_URL=https://api.whatsapp-sim.local
WA_AUTH_TOKEN=dummy_wa_token_dev
